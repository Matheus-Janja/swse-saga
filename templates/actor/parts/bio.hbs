<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="bio">
  <div class="grid-3 details">
    <label>{{localize "SWSE.Details.player"}} <input type="text" name="system.details.player" value="{{system.details.player}}"></label>
    <label>{{localize "SWSE.Details.age"}} <input type="text" name="system.details.age" value="{{system.details.age}}"></label>
    <label>{{localize "SWSE.Details.gender"}} <input type="text" name="system.details.gender" value="{{system.details.gender}}"></label>
    <label>{{localize "SWSE.Details.height"}} <input type="text" name="system.details.height" value="{{system.details.height}}"></label>
    <label>{{localize "SWSE.Details.weight"}} <input type="text" name="system.details.weight" value="{{system.details.weight}}"></label>
    <label>{{localize "SWSE.Details.homeworld"}} <input type="text" name="system.details.homeworld" value="{{system.details.homeworld}}"></label>
    <label class="wide">{{localize "SWSE.Details.languages"}} <input type="text" name="system.details.languages" value="{{system.details.languages}}"></label>
    <label class="wide">{{localize "SWSE.Details.destiny"}} <input type="text" name="system.details.destiny" value="{{system.details.destiny}}"></label>
  </div>
  {{#if military}}
  <details class="panel military" {{#if system.military.organization}}open{{/if}}>
    <summary><h3><img src="systems/swse-saga/assets/icons/rank.svg" width="18" height="18" alt=""> {{localize "SWSE.Military.title"}}{{#if system.military.organization}} — {{military.title}}{{/if}}</h3></summary>
    <div class="grid-3">
      <label class="wide">{{localize "SWSE.Military.organization"}} <input type="text" name="system.military.organization" value="{{system.military.organization}}"></label>
      <label>{{localize "SWSE.Military.manual"}} <input type="number" name="system.military.score" value="{{system.military.score}}" data-dtype="Number"></label>
      <label class="checkbox"><input type="checkbox" name="system.military.nco" {{checked system.military.nco}}> {{localize "SWSE.Military.nco"}}</label>
    </div>
    <p class="rank-line"><strong>{{military.title}}</strong> (Rank {{military.rank}}) — {{localize "SWSE.Military.score"}} {{military.score}} ·
      {{localize "SWSE.Military.bonus"}} {{swseSigned military.bonus}} ·
      {{localize "SWSE.Military.orders"}}: {{military.orders.[0]}} {{localize "SWSE.Military.minor"}}, {{military.orders.[1]}} {{localize "SWSE.Military.major"}}, {{military.orders.[2]}} {{localize "SWSE.Military.command"}}</p>
    {{#if military.benefit}}<p class="hint">{{military.benefit}}</p>{{/if}}
    <details><summary>{{localize "SWSE.Military.breakdown"}}</summary>
      <ul>{{#each military.parts}}<li>{{this.label}}: {{swseSigned this.value}}</li>{{/each}}</ul>
      <p class="hint">{{localize "SWSE.Military.hint"}}</p>
    </details>
  </details>
  {{/if}}
  {{#if species}}
  <div class="panel">
    <h3>{{localize "SWSE.SpeciesTraits"}} — {{species.name}}</h3>
    <ul class="traits">{{#each species.system.traits}}<li><strong>{{this.name}}:</strong> {{this.text}}</li>{{/each}}</ul>
  </div>
  {{/if}}
  <div class="panel biography">
    <h3>{{localize "SWSE.Biography"}}</h3>
    {{formInput biographyField value=system.details.biography enriched=enrichedBiography name="system.details.biography" toggled=true}}
  </div>
</section>
