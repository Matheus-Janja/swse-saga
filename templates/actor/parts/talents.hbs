<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="talents">
  <div class="grid-2">
    <div class="panel">
      <h3>{{localize "SWSE.Feats"}}
        {{#if editable}}<a class="ctl" data-action="openCompendium" data-pack="feats"><i class="fa-solid fa-book-atlas"></i></a>{{/if}}</h3>
      <ul class="item-list">
        {{#each feats as |f|}}
        <li class="item" data-item-id="{{f.id}}">
          <img src="{{f.img}}"><a data-action="itemToChat" data-tooltip="{{f.system.prerequisites.text}}">{{f.displayName}}</a>
          {{#if f.system.choice.type}}<a class="ctl" data-action="editChoice" data-tooltip="{{localize 'SWSE.Choice.prompt'}}"><i class="fa-solid fa-list"></i></a>{{/if}}
          <a class="ctl" data-action="editItem"><i class="fa-solid fa-pen"></i></a>
          {{#if ../editable}}<a class="ctl" data-action="deleteItem"><i class="fa-solid fa-trash"></i></a>{{/if}}
        </li>
        {{/each}}
      </ul>
    </div>
    <div class="panel">
      <h3>{{localize "SWSE.Talents"}}
        {{#if editable}}<a class="ctl" data-action="openCompendium" data-pack="talents"><i class="fa-solid fa-book-atlas"></i></a>{{/if}}</h3>
      {{#each talentTrees as |t|}}
      <h4>{{t.tree}}</h4>
      <ul class="item-list">
        {{#each t.list as |i|}}
        <li class="item" data-item-id="{{i.id}}">
          <img src="{{i.img}}"><a data-action="itemToChat">{{i.displayName}}</a>
          {{#if i.system.choice.type}}<a class="ctl" data-action="editChoice"><i class="fa-solid fa-list"></i></a>{{/if}}
          <a class="ctl" data-action="editItem"><i class="fa-solid fa-pen"></i></a>
          {{#if @root.editable}}<a class="ctl" data-action="deleteItem"><i class="fa-solid fa-trash"></i></a>{{/if}}
        </li>
        {{/each}}
      </ul>
      {{/each}}
    </div>
  </div>
</section>
