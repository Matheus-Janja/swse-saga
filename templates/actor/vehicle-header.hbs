<header class="sheet-header swse-header">
  <img class="portrait" src="{{actor.img}}" alt="{{actor.name}}" data-action="editImage" data-edit="img">
  <div class="header-main">
    <div class="name-row">
      <input class="actor-name" type="text" name="name" value="{{actor.name}}">
      <label class="cl">CL <input type="number" name="system.challengeLevel" value="{{system.challengeLevel}}"></label>
    </div>
    <div class="summary-row">
      <select name="system.size">{{selectOptions sizes selected=system.size localize=true}}</select>
      <select name="system.category">{{selectOptions categories selected=system.category localize=true}}</select>
      <input type="text" name="system.vehicleType" value="{{system.vehicleType}}" placeholder="{{localize 'SWSE.Vehicle.Type'}}">
    </div>
    <div class="resource-row">
      <div class="resource hp">
        <label>{{localize "SWSE.HP"}}</label>
        <div class="bar"><div class="fill" style="width: {{hpPct}}%"></div></div>
        <div class="vals"><input type="number" name="system.hp.value" value="{{system.hp.value}}"> / <input type="number" name="system.hp.max" value="{{system.hp.max}}"></div>
      </div>
      <div class="resource">
        <label>{{localize "SWSE.DamageThresholdAbbr"}}</label>
        <span class="big">{{system.damageThreshold.total}}</span>
      </div>
      <div class="resource">
        <label>{{localize "SWSE.ShieldRating"}}</label>
        <div class="vals"><input type="number" name="system.shieldRating" value="{{system.shieldRating}}"> / <input type="number" name="system.shieldMax" value="{{system.shieldMax}}"></div>
      </div>
      <div class="resource">
        <label>{{localize "SWSE.DamageReduction"}}</label>
        <input type="number" name="system.damageReduction" value="{{system.damageReduction}}">
      </div>
      <div class="resource">
        <label>{{localize "SWSE.Speed"}}</label>
        <div class="vals"><input type="number" name="system.speed.character" value="{{system.speed.character}}" data-tooltip="{{localize 'SWSE.Vehicle.CharScale'}}"> / <input type="number" name="system.speed.starship" value="{{system.speed.starship}}" data-tooltip="{{localize 'SWSE.Vehicle.ShipScale'}}"></div>
      </div>
    </div>
  </div>
</header>
